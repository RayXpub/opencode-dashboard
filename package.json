{
  "name": "opencode-dashboard",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/server/index.js",
  "exports": {
    ".": "./dist/server/index.js",
    "./server": "./dist/server/index.js",
    "./tui": "./dist/tui/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "opencode": ">=1.18.30"
  },
  "scripts": {
    "dev": "bun --hot src/collector/index.ts",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "bun run clean",
    "build": "bun scripts/build.ts",
    "start": "bun dist/collector/index.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@opencode-ai/plugin": "^1.18.25",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5",
    "@types/bun": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  }
}
